# Copy this file to .env and replace both passwords before using Compose.
# Avoid $, :, /, ?, #, @, and spaces in MONGO_PASSWORD unless URI-encoded.
MONGO_USERNAME=tmail
MONGO_PASSWORD=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
MAIL_DOMAIN=drop.localhost
SMTP_HOSTNAME=mail.localhost
WEB_HOSTS=localhost;127.0.0.1
# Set to the exact trusted proxy address as seen by the container when proxying HTTPS.
TRUSTED_PROXY_IP=127.0.0.1
