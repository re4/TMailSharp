# Copy to /etc/tmailsharp/tmailsharp.env on the Linux server.
# This is a Docker env-file: literal KEY=value entries, no export or shell quotes.
# Fill in secrets on the server. Never commit the populated file.

Mongo__ConnectionString=mongodb://APP_USER:URI_ENCODED_PASSWORD@127.0.0.1:27017/tmailsharp?authSource=tmailsharp
Mongo__Database=tmailsharp
Admin__Password=
DataProtection__KeyDirectory=/var/lib/tmailsharp/keys

# Use your web hostname and mail domains. localhost permits local health checks.
AllowedHosts=localhost;tmail.example.com
Mail__Domains__0=inbox.example.com
Mail__Domains__1=inbox.example.com
Mail__Domains__2=inbox.example.com
Mail__LifetimeMinutes=60

# Keep loopback for a local mail gateway. Set 0.0.0.0 only when publishing this receiver.
Smtp__Enabled=true
Smtp__Host=127.0.0.1
Smtp__Port=2525
Smtp__ServerName=mail.example.com
# Smtp__CertificatePath=/var/lib/tmailsharp/keys/mail.pfx
# Smtp__CertificatePassword=

# Deployment-only settings; the app ignores these configuration keys.
Deploy__HttpPort=5080
Deploy__HealthHost=localhost

# A reverse proxy on this host is trusted automatically. Add exact addresses only
# for a remote trusted proxy; do not enable arbitrary forwarded headers.
# ReverseProxy__KnownProxies__0=192.0.2.10
