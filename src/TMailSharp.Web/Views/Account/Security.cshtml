@model SecurityViewModel
@{ ViewData["Title"] = "Account security"; }
<main class="account-shell"><div class="eyebrow">@User.Identity?.Name</div><h1>Keep your account secure.</h1>
<section class="account-card"><h2>Two-factor authentication</h2>
@if (Model.TwoFactorEnabled)
{
  <p>Authenticator enabled. @Model.RecoveryCodesRemaining recovery codes remain.</p>
  <form action="/account/recovery-codes" method="post" class="account-form">@Html.AntiForgeryToken()
    <label>Current password<input name="Password" class="form-input" type="password" autocomplete="current-password" required></label><button class="secondary-button">Generate new recovery codes</button>
  </form>
  <details><summary>Disable authenticator</summary><form action="/account/authenticator/disable" method="post" class="account-form">@Html.AntiForgeryToken()
    <label>Current password<input name="Password" type="password" class="form-input" autocomplete="current-password" required></label>
    <label>Current authenticator code<input name="Code" class="form-input" autocomplete="one-time-code" required></label><button class="secondary-button">Disable authenticator</button>
  </form></details>
}
else
{
  <p>Add a time-based code from an authenticator app as a second step after your password.</p>
  <form action="/account/authenticator/setup" method="post" class="account-form">@Html.AntiForgeryToken()
    <label>Current password<input name="Password" class="form-input" type="password" autocomplete="current-password" required></label><button class="primary-button">Set up authenticator</button>
  </form>
}
</section>
<section class="account-card"><h2>Passkeys &amp; YubiKeys</h2><p>Sign in using a FIDO2 security key, Windows Hello, or a compatible device. Your device will ask for its PIN or biometrics. Passkey sign-in replaces the password and authenticator-code steps.</p>
@foreach (var passkey in Model.Passkeys)
{
  <details class="key-row"><summary>@passkey.Name</summary><form action="/account/passkeys/remove" method="post" class="account-form">@Html.AntiForgeryToken()
    <input type="hidden" name="CredentialId" value="@WebEncoders.Base64UrlEncode(passkey.CredentialId)">
    <label>Current password<input type="password" class="form-input" name="Password" autocomplete="current-password" required></label><button class="secondary-button">Remove this key</button>
  </form></details>
}
<form id="passkey-add" class="account-form">
  <label for="key-name">Key name</label><input id="key-name" class="form-input" maxlength="100" placeholder="e.g. My YubiKey" required>
  <label for="key-password">Current password</label><input id="key-password" type="password" class="form-input" autocomplete="current-password" required>
  <button class="primary-button">Add a passkey or security key</button>
</form><p id="passkey-status" role="status" class="form-error"></p></section>
<section class="account-card"><h2>Change password</h2><form action="/account/password" method="post" class="account-form">@Html.AntiForgeryToken()
  <label>Current password<input name="CurrentPassword" class="form-input" type="password" autocomplete="current-password" required></label>
  <label>New password<input name="NewPassword" class="form-input" type="password" autocomplete="new-password" minlength="12" required></label>
  <label>Confirm new password<input name="ConfirmPassword" class="form-input" type="password" autocomplete="new-password" minlength="12" required></label>
  <button class="secondary-button">Change password</button>
</form></section></main>
@section Scripts { <script src="/account.js" type="module"></script> }
