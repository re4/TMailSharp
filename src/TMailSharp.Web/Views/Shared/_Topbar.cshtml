<header class="topbar">
  <div class="topbar-leading">
    <button id="navigation-toggle" class="icon-button menu-toggle" type="button" aria-controls="site-sidebar" aria-expanded="false" aria-label="Open navigation"><svg aria-hidden="true"><use href="/icons.svg#menu"/></svg></button>
    <span class="breadcrumb">@(ViewData["InboxLayout"] is true ? "Your space" : "Your account") <span>/</span> <strong>@ViewData["Title"]</strong></span>
  </div>
  <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to light mode"><svg aria-hidden="true"><use href="/icons.svg#sun"/></svg></button>
</header>
