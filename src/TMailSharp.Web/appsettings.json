{
  "Mongo": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "Database": "tmailsharp"
  },
  "Mail": {
    "Domains": [ "drop.localhost", "inbox.localhost", "mail.localhost" ],
    "LifetimeMinutes": 60,
    "MessageRetentionMinutes": 60,
    "MaxMailboxesPerAccount": 25,
    "MaxMailboxesPerSession": 10,
    "MaxMessageBytes": 5242880,
    "MaxMessagesPerMailbox": 100,
    "AddressReuseDelayDays": 7
  },
  "Smtp": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 2525,
    "ServerName": "mail.localhost",
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Admin": { "UserName": "admin", "Password": "" },
  "Demo": { "Enabled": false },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
